{
  "rules": {
    ".read": false,
    ".write": false,
    "presentations": {
      "$room": {
        ".read": "auth != null && data.exists() && data.child('expiresAt').val() > now",
        ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid && $room.matches(/^[a-f0-9-]{36}$/)) || data.child('owner').val() === auth.uid)",
        ".validate": "newData.hasChildren(['owner', 'expiresAt', 'state'])",
        "owner": { ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || newData.val() === data.val())" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 43200000 && (!data.exists() || newData.val() === data.val())" },
        "state": {
          ".validate": "newData.hasChildren(['slug', 'mode', 'index', 'blank', 'dark', 'active', 'updatedAt'])",
          "slug": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250" },
          "mode": { ".validate": "newData.val() === 'lyrics' || newData.val() === 'chord'" },
          "index": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000 && newData.val() % 1 === 0" },
          "blank": { ".validate": "newData.isBoolean()" },
          "dark": { ".validate": "newData.isBoolean()" },
          "active": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
